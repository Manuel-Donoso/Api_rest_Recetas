<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Si el archivo o la carpeta solicitada existen de verdad (como una imagen), búscala directamente
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    
    # Si no existen, redirige todo discretamente a index.php manteniendo la ruta en la URL
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>
